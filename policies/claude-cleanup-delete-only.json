{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SoApagarParar",
      "Effect": "Allow",
      "Action": [
        "athena:Delete*",
        "autoscaling:Delete*",
        "autoscaling:Detach*",
        "autoscaling:UpdateAutoScalingGroup",
        "backup:Delete*",
        "backup:Disassociate*",
        "cloudformation:Delete*",
        "cloudfront:Delete*",
        "cloudtrail:Delete*",
        "cloudtrail:StopLogging",
        "cloudwatch:Delete*",
        "config:Delete*",
        "config:Stop*",
        "datasync:Cancel*",
        "datasync:Delete*",
        "dlm:Delete*",
        "dynamodb:Delete*",
        "ec2:Cancel*",
        "ec2:Delete*",
        "ec2:Deregister*",
        "ec2:Detach*",
        "ec2:Disable*",
        "ec2:Disassociate*",
        "ec2:Release*",
        "ec2:Revoke*",
        "ec2:Stop*",
        "ec2:Terminate*",
        "ecr:Delete*",
        "ecs:Delete*",
        "ecs:Deregister*",
        "ecs:UpdateService",
        "elasticache:Delete*",
        "elasticfilesystem:Delete*",
        "elasticloadbalancing:Delete*",
        "elasticloadbalancing:Deregister*",
        "elasticloadbalancing:Remove*",
        "events:Delete*",
        "fsx:Cancel*",
        "fsx:Delete*",
        "glacier:Abort*",
        "glacier:Delete*",
        "glue:Delete*",
        "guardduty:Delete*",
        "guardduty:Disassociate*",
        "iam:Delete*",
        "iam:Detach*",
        "iam:Remove*",
        "kms:Delete*",
        "kms:Disable*",
        "lambda:Delete*",
        "logs:Delete*",
        "rds:Delete*",
        "rds:Stop*",
        "route53:Delete*",
        "s3:Abort*",
        "s3:Delete*",
        "s3express:Delete*",
        "s3tables:Delete*",
        "secretsmanager:Delete*",
        "snowball:Cancel*",
        "sns:Delete*",
        "sqs:Delete*",
        "sqs:Purge*",
        "ssm:Delete*",
        "storagegateway:Cancel*",
        "storagegateway:Delete*",
        "storagegateway:Detach*",
        "transfer:Delete*",
        "transfer:Stop*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DesligarProtecoesParaApagar",
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyInstanceAttribute",
        "rds:ModifyDBInstance",
        "rds:ModifyDBCluster",
        "elasticloadbalancing:ModifyLoadBalancerAttributes",
        "dynamodb:UpdateTable",
        "cloudformation:UpdateTerminationProtection",
        "s3:BypassGovernanceRetention",
        "s3:PutObjectLegalHold",
        "kms:ScheduleKeyDeletion"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NegarIAMForaDosRecursosDeLab",
      "Effect": "Deny",
      "Action": [
        "iam:Delete*",
        "iam:Detach*",
        "iam:Remove*",
        "iam:Deactivate*",
        "iam:Disable*",
        "iam:Untag*",
        "iam:Update*",
        "iam:Put*",
        "iam:Attach*",
        "iam:Create*"
      ],
      "NotResource": [
        "arn:aws:iam::004009722521:role/lab-*",
        "arn:aws:iam::004009722521:instance-profile/lab-*"
      ]
    },
    {
      "Sid": "NegarLabS3ReadRole",
      "Effect": "Deny",
      "Action": [
        "iam:Delete*",
        "iam:Detach*",
        "iam:Remove*",
        "iam:Deactivate*",
        "iam:Disable*",
        "iam:Untag*",
        "iam:Update*",
        "iam:Put*",
        "iam:Attach*",
        "iam:Create*"
      ],
      "Resource": [
        "arn:aws:iam::004009722521:role/lab-s3-read-role",
        "arn:aws:iam::004009722521:instance-profile/lab-s3-read-role",
        "arn:aws:iam::004009722521:role/lab-storage-ec2-ssm",
        "arn:aws:iam::004009722521:instance-profile/lab-storage-ec2-profile"
      ]
    },
    {
      "Sid": "NegarConfigsDeContaBillingBudget",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteAccountAlias",
        "iam:DeleteAccountPasswordPolicy",
        "iam:UpdateAccountPasswordPolicy",
        "account:*",
        "aws-portal:Modify*",
        "billing:*",
        "payments:*",
        "tax:*",
        "invoicing:*",
        "budgets:Delete*",
        "budgets:Modify*",
        "budgets:Update*",
        "budgets:Execute*",
        "organizations:*",
        "sso:*",
        "identitystore:*"
      ],
      "Resource": "*"
    }
  ]
}
