{
  "mcpServers": {
    "aws-api": {
      "command": "docker",
      "args": [
        "run", "--rm", "--interactive",
        "--env", "AWS_REGION=us-east-1",
        "--env", "AWS_API_MCP_PROFILE_NAME=default",
        "--env", "READ_OPERATIONS_ONLY=true",
        "--env", "AWS_API_MCP_TELEMETRY=false",
        "--env", "AWS_API_MCP_SUPPRESS_DEPRECATION_WARNING=true",
        "--tmpfs", "/app/.aws:uid=1000,gid=999",
        "--volume", "/home/wyller/.aws/config:/app/.aws/config:ro",
        "--volume", "/home/wyller/.aws/credentials:/app/.aws/credentials:ro",
        "public.ecr.aws/awslabs-mcp/awslabs/aws-api-mcp-server:1.5.6"
      ]
    },
    "aws-knowledge": {
      "type": "http",
      "url": "https://knowledge-mcp.global.api.aws"
    }
  }
}
