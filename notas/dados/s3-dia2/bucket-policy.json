{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "DenyInsecureTransport",
            "Effect": "Deny",
            "Principal": "*",
            "Action": "s3:*",
            "Resource": [
                "arn:aws:s3:::lab-s3-dia2-004009722521/*",
                "arn:aws:s3:::lab-s3-dia2-004009722521"
            ],
            "Condition": {
                "Bool": {
                    "aws:SecureTransport": "false"
                }
            }
        },
        {
            "Sid": "DenyRestrictedToReadonly",
            "Effect": "Deny",
            "Principal": {
                "AWS": "arn:aws:iam::004009722521:user/readonly-user"
            },
            "Action": [
                "s3:GetObjectVersion",
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::lab-s3-dia2-004009722521/restricted/*"
        }
    ]
}
